  - stringKey: Str_Infra_Clinic_Desc_0001
    ko: "\uD734\uC2DD \uD65C\uB3D9\uC5D0 \uC18C\uBAA8\uB418\uB294 \uBE44\uC6A9\uC774\\n{infraEffectValue}%\uB9CC\uD07C
